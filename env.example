# Required for a controlled production admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Recommended durable storage on Render (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CB_DB_KEY=cryptobridge_data

# Alternative: Render persistent disk mounted at this path.
# Set CB_PERSISTENT_DISK=true only when DATA_DIR is actually mounted persistently.
DATA_DIR=
CB_PERSISTENT_DISK=false

# Optional payment integration (only if used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password recovery email OTP (required for Forgot Password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Crypto Bridge <no-reply@example.com>
